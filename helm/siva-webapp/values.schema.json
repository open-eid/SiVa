{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "siva-webapp values",
  "type": "object",
  "required": ["image", "service", "config", "probes", "security"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": { "type": "array" }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nodePort": { "type": ["integer", "string"] }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "mountPath": { "type": "string" },
        "applicationYaml": { "type": "string" }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "managementPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "shutdownTimeout": { "type": "string", "pattern": "^[1-9][0-9]*s$" },
        "preStopSleepSeconds": { "type": "integer", "minimum": 0 },
        "forwardHeadersStrategy": { "type": "string", "enum": ["none", "native", "framework"] },
        "javaToolOptions": { "type": "string" }
      }
    },
    "env": { "type": "array" },
    "envFrom": { "type": "object", "properties": { "existingSecret": { "type": "string" } } },
    "probes": { "type": "object" },
    "resources": { "type": "object" },
    "network": {
      "type": "object",
      "properties": {
        "networkPolicy": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "ingressFrom": { "type": "array" },
            "managementFrom": { "type": "array" }
          }
        },
        "ingresses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "hosts"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "className": { "type": "string" },
              "annotations": { "type": "object" },
              "hosts": { "type": "array" },
              "tls": { "type": "array" }
            }
          }
        }
      }
    },
    "scaling": {
      "type": "object",
      "properties": {
        "pdb": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "minAvailable": { "type": ["integer", "string"] },
            "maxUnavailable": { "type": ["integer", "string"] }
          }
        },
        "hpa": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "targetCPUUtilizationPercentage": { "type": ["integer", "string"] },
            "targetMemoryUtilizationPercentage": { "type": ["integer", "string"] },
            "customMetrics": { "type": "array" },
            "behavior": { "type": "object" }
          }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
            "scrapeTimeout": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
            "labels": { "type": "object" },
            "namespace": { "type": "string" },
            "relabelings": { "type": "array" }
          }
        },
        "prometheusRule": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": { "type": "object" },
            "namespace": { "type": "string" },
            "pendingRules": { "type": "boolean" },
            "additionalRules": { "type": "array" }
          }
        },
        "grafanaDashboard": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": { "type": "object" },
            "annotations": { "type": "object" },
            "namespace": { "type": "string" }
          }
        }
      }
    },
    "security": { "type": "object" },
    "serviceAccount": { "type": "object" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "tmpSizeLimit": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|k|m)?)?$" },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["maxSkew", "topologyKey", "whenUnsatisfiable"],
        "properties": {
          "maxSkew": { "type": "integer", "minimum": 1 },
          "topologyKey": { "type": "string", "minLength": 1 },
          "whenUnsatisfiable": { "type": "string", "enum": ["DoNotSchedule", "ScheduleAnyway"] },
          "labelSelector": { "type": "object" }
        }
      }
    },
    "tests": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "runAsUser": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
